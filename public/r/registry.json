{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "ggc",
  "homepage": "https://github.com/gyeonggi-council/ggc-design-system",
  "items": [
    {
      "name": "ggc-tokens",
      "type": "registry:file",
      "title": "GGC 디자인 토큰 (정본 사본)",
      "description": "design/ggc-tokens.css 를 그대로 복사한다. 값의 유일한 원천이며 check_design.py D1 이 바이트 대조한다. globals.css 첫 줄에 @import 로 불러온다.",
      "files": [
        { "path": "design/ggc-tokens.css", "type": "registry:file", "target": "~/styles/ggc-tokens.css" }
      ],
      "docs": "globals.css(또는 index.css) **첫 줄**에  @import \"../styles/ggc-tokens.css\";  를 넣는다(@import 는 파일 선두여야 해서 CLI 가 넣지 못한다). 폰트는 저장소의 design/ggc-fonts.css + design/fonts/PretendardGOVVariable.subset.woff2 를 public/fonts/ 로 복사하고 토큰보다 먼저 링크한다. 검사: python <저장소>/design/check_design.py --gate ."
    },
    {
      "name": "ggc-theme",
      "type": "registry:theme",
      "title": "GGC 테마 — shadcn 변수를 --ggc-* 토큰으로 매핑",
      "description": "shadcn 의 --primary · --background · --radius 등을 전부 var(--ggc-*) 로 돌린다. 값(hex)은 하나도 없다 — 값은 ggc-tokens.css 한 곳에만 산다. 다크 팔레트는 없다(계약 §3).",
      "registryDependencies": ["@ggc/ggc-tokens"],
      "cssVars": {
        "theme": {
          "font-sans": "var(--ggc-font)",
          "font-mono": "var(--ggc-font-mono)"
        },
        "light": {
          "background": "var(--ggc-bg)",
          "foreground": "var(--ggc-text)",
          "card": "var(--ggc-surface)",
          "card-foreground": "var(--ggc-text)",
          "popover": "var(--ggc-surface)",
          "popover-foreground": "var(--ggc-text)",
          "primary": "var(--ggc-primary)",
          "primary-foreground": "#ffffff",
          "secondary": "var(--ggc-surface-inset)",
          "secondary-foreground": "var(--ggc-primary-deep)",
          "muted": "var(--ggc-control-bg)",
          "muted-foreground": "var(--ggc-text-muted)",
          "accent": "var(--ggc-primary-light)",
          "accent-foreground": "var(--ggc-primary-deep)",
          "destructive": "var(--ggc-danger)",
          "destructive-foreground": "#ffffff",
          "border": "var(--ggc-border)",
          "input": "var(--ggc-border-strong)",
          "ring": "var(--ggc-primary)",
          "radius": "var(--ggc-radius)",
          "chart-1": "var(--ggc-primary)",
          "chart-2": "var(--ggc-info)",
          "chart-3": "var(--ggc-success)",
          "chart-4": "var(--ggc-warning)",
          "chart-5": "var(--ggc-danger)",
          "sidebar": "var(--ggc-surface)",
          "sidebar-foreground": "var(--ggc-text)",
          "sidebar-primary": "var(--ggc-primary)",
          "sidebar-primary-foreground": "#ffffff",
          "sidebar-accent": "var(--ggc-primary-light)",
          "sidebar-accent-foreground": "var(--ggc-primary-deep)",
          "sidebar-border": "var(--ggc-shell-border)",
          "sidebar-ring": "var(--ggc-primary)"
        }
      },
      "css": {
        "@layer base": {
          "body": {
            "font-family": "var(--ggc-font)",
            "background-color": "var(--ggc-bg)",
            "color": "var(--ggc-text)",
            "-webkit-font-smoothing": "antialiased"
          },
          "a": { "text-underline-offset": "2px" }
        }
      },
      "docs": "radius 단계는 토큰을 직접 쓴다 — Tailwind 유틸 rounded-(--ggc-radius) / rounded-(--ggc-radius-sm) / rounded-(--ggc-radius-lg). 다크 모드 변수를 만들지 않는다(계약 §3-2)."
    },
    {
      "name": "ggc-style",
      "type": "registry:style",
      "title": "GGC 스타일 — 한 번에 착지",
      "description": "npx shadcn init @ggc/ggc-style 한 번으로 토큰 파일 · 테마 · P0 컴포넌트가 들어온다.",
      "registryDependencies": [
        "utils",
        "@ggc/ggc-tokens", "@ggc/ggc-theme",
        "@ggc/button", "@ggc/badge", "@ggc/card", "@ggc/input", "@ggc/label", "@ggc/textarea",
        "@ggc/select", "@ggc/checkbox", "@ggc/radio-group", "@ggc/dialog", "@ggc/tabs", "@ggc/alert",
        "@ggc/breadcrumb", "@ggc/pagination", "@ggc/table", "@ggc/skeleton", "@ggc/spinner"
      ],
      "dependencies": ["radix-ui", "class-variance-authority", "lucide-react"]
    },

    { "name": "button", "type": "registry:ui", "title": "버튼", "description": "primary · secondary · ghost · dashed · destructive. 높이는 --ggc-control-h* (프로필을 따른다). primary 만 그림자.",
      "dependencies": ["radix-ui", "class-variance-authority"],
      "files": [{ "path": "registry/ggc/ui/button.tsx", "type": "registry:ui" }] },
    { "name": "badge", "type": "registry:ui", "title": "배지 · 태그", "description": "알약형 상태 배지(회기·결재·역할) + 사각 태그. 색 단독 금지 — 텍스트·기호를 함께.",
      "dependencies": ["radix-ui", "class-variance-authority"],
      "files": [{ "path": "registry/ggc/ui/badge.tsx", "type": "registry:ui" }] },
    { "name": "card", "type": "registry:ui", "title": "카드", "description": "흰 면 · 1px 테두리 · radius 16 · 그림자 없음(계약 §2). 헤더·액션·본문·푸터.",
      "files": [{ "path": "registry/ggc/ui/card.tsx", "type": "registry:ui" }] },
    { "name": "input", "type": "registry:ui", "title": "입력", "description": "높이 --ggc-input-h · 1px border-strong · radius 10 · 공통 포커스 링.",
      "files": [{ "path": "registry/ggc/ui/input.tsx", "type": "registry:ui" }] },
    { "name": "label", "type": "registry:ui", "title": "라벨", "description": "폼 라벨 13px/700(--ggc-label-font). 필수 표시는 <Label required>.",
      "dependencies": ["radix-ui"],
      "files": [{ "path": "registry/ggc/ui/label.tsx", "type": "registry:ui" }] },
    { "name": "textarea", "type": "registry:ui", "title": "텍스트 영역",
      "files": [{ "path": "registry/ggc/ui/textarea.tsx", "type": "registry:ui" }] },
    { "name": "select", "type": "registry:ui", "title": "셀렉트 (네이티브)", "description": "항목 20개 이하는 네이티브 <select>. 화살표는 CSS.",
      "files": [{ "path": "registry/ggc/ui/select.tsx", "type": "registry:ui" }] },
    { "name": "checkbox", "type": "registry:ui", "title": "체크박스", "description": "20px 상자 · 선택은 네이비 채움 + 흰 체크.",
      "dependencies": ["radix-ui", "lucide-react"],
      "files": [{ "path": "registry/ggc/ui/checkbox.tsx", "type": "registry:ui" }] },
    { "name": "radio-group", "type": "registry:ui", "title": "라디오",
      "dependencies": ["radix-ui"],
      "files": [{ "path": "registry/ggc/ui/radio-group.tsx", "type": "registry:ui" }] },
    { "name": "dialog", "type": "registry:ui", "title": "모달 · 다이얼로그", "description": "제목 · 본문 · 버튼 행. 파괴적 동작은 alert 모드(배경 클릭으로 닫히지 않음).",
      "dependencies": ["radix-ui", "lucide-react"], "registryDependencies": ["@ggc/button"],
      "files": [{ "path": "registry/ggc/ui/dialog.tsx", "type": "registry:ui" }] },
    { "name": "tabs", "type": "registry:ui", "title": "탭", "description": "밑줄형(KRDS line). 선택은 색 + 2px 선.",
      "dependencies": ["radix-ui"],
      "files": [{ "path": "registry/ggc/ui/tabs.tsx", "type": "registry:ui" }] },
    { "name": "alert", "type": "registry:ui", "title": "알림 · 콜아웃", "description": "info · success · warning · danger · banner. 기호 + 제목 + 문구.",
      "dependencies": ["class-variance-authority"],
      "files": [{ "path": "registry/ggc/ui/alert.tsx", "type": "registry:ui" }] },
    { "name": "breadcrumb", "type": "registry:ui", "title": "브레드크럼",
      "dependencies": ["radix-ui", "lucide-react"],
      "files": [{ "path": "registry/ggc/ui/breadcrumb.tsx", "type": "registry:ui" }] },
    { "name": "pagination", "type": "registry:ui", "title": "페이지네이션",
      "dependencies": ["lucide-react"], "registryDependencies": ["@ggc/button"],
      "files": [{ "path": "registry/ggc/ui/pagination.tsx", "type": "registry:ui" }] },
    { "name": "table", "type": "registry:ui", "title": "표", "description": "thead 상단 2px primary-deep · 행 구분 hairline · .num 우정렬 tabular-nums.",
      "files": [{ "path": "registry/ggc/ui/table.tsx", "type": "registry:ui" }] },
    { "name": "skeleton", "type": "registry:ui", "title": "스켈레톤",
      "files": [{ "path": "registry/ggc/ui/skeleton.tsx", "type": "registry:ui" }] },
    { "name": "spinner", "type": "registry:ui", "title": "스피너", "description": "role=status + sr 텍스트. sm/기본/lg.",
      "files": [{ "path": "registry/ggc/ui/spinner.tsx", "type": "registry:ui" }] },

    { "name": "ggc-shell", "type": "registry:block", "title": "업무 셸", "description": "유틸리티 바 + GNB 64 + LNB 256 + 본문 1320/1360. 계약 §2. 대민 화면에는 쓰지 않는다.",
      "registryDependencies": ["@ggc/ggc-tokens"],
      "files": [{ "path": "registry/ggc/blocks/ggc-shell/ggc-shell.tsx", "type": "registry:component" }] },
    { "name": "ggc-stat", "type": "registry:block", "title": "통계 타일 (KPI)", "description": "Monitor 첫 행. 정확히 4개.",
      "files": [{ "path": "registry/ggc/blocks/ggc-stat/ggc-stat.tsx", "type": "registry:component" }] },
    { "name": "ggc-stepper", "type": "registry:block", "title": "스텝퍼 / 위저드", "description": "완료 · 현재 · 대기. 현재 단계는 색과 형태 둘 다.",
      "files": [{ "path": "registry/ggc/blocks/ggc-stepper/ggc-stepper.tsx", "type": "registry:component" }] },
    { "name": "ggc-actionbar", "type": "registry:block", "title": "하단 스티키 액션바", "description": "Configure 슬롯 5. 임시저장 → 상신 순서 고정.",
      "registryDependencies": ["@ggc/button"],
      "files": [{ "path": "registry/ggc/blocks/ggc-actionbar/ggc-actionbar.tsx", "type": "registry:component" }] },
    { "name": "ggc-page-head", "type": "registry:block", "title": "페이지 헤더", "description": "브레드크럼 + 제목 + 메타 + 주 액션 하나.",
      "registryDependencies": ["@ggc/breadcrumb"],
      "files": [{ "path": "registry/ggc/blocks/ggc-page-head/ggc-page-head.tsx", "type": "registry:component" }] }
  ]
}
